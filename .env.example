# Copy to .env at the repository root. Never commit real credentials.
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Demo mode starts a seeded, in-memory demo store with no database required.
# For MySQL, set DB_MODE=mysql and configure the values below.
DB_MODE=demo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pure_aqua
DB_USER=root
DB_PASSWORD=

# Replace the JWT placeholder before deploying. Keep database/JWT secrets server-side only.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Safe simulated payment flow; no real payment provider is contacted.
PAYMENT_MODE=mock
